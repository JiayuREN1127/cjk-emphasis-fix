{
  "name": "obsidian-cjk-emphasis-fix",
  "version": "0.3.1",
  "description": "Render bold and italic next to CJK punctuation in Obsidian Live Preview.",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node tests/scanner.test.mjs",
    "lint": "eslint src"
  },
  "keywords": [
    "obsidian",
    "cjk",
    "markdown",
    "bold",
    "italic"
  ],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "^6.12.1",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.15",
    "@lezer/common": "^1.5.1",
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "esbuild": "0.25.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JiayuREN1127/cjk-emphasis-fix.git"
  }
}
